# === Required for Live Gemini LLM & Embeddings ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Provider Configuration ===
# LLM_PROVIDER: "gemini" | "mock" | "auto" (auto selects gemini if GEMINI_API_KEY is set, else mock)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.5-flash-lite

# EMBEDDING_PROVIDER: "gemini" | "hash" | "auto" (auto selects gemini if GEMINI_API_KEY is set, else hash)
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# === MCP Transport Configuration ===
# MCP_TRANSPORT: "stdio" (default single-service deployment) | "streamable-http" (separate MCP service)
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# === RAG & Safety Parameters ===
RAG_TOP_K=5
RAG_MIN_RRF_SCORE=0.008
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=60
RANDOM_SEED=42

# === Runtime / Server ===
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
